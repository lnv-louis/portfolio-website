{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lenguyenvu",
  "account_id": "062a91f6e4ad306625307277f1fe668b",
  "compatibility_date": "2026-08-20",
  // src/worker.ts: MCP server, markdown negotiation, Link/Vary headers, markdown 404s.
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Real 404 status with the prerendered dist/404.html instead of an SPA fallback,
    // so missing files (sitemaps, .well-known/*) aren't answered with the homepage.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // The Worker sees every request (MCP, markdown negotiation, markdown 404s) and
    // passes anything it doesn't handle straight to the assets binding.
    "run_worker_first": true
  },
  "build": {
    "command": "bun run build",
    "watch_dir": "./src"
  }
}
